<INDIDriver>

    <!-- mount/telescope -->
    <defNumberVector device="Seestar" name="EQUATORIAL_EOD_COORD" label="Sky Coordinates (JNow)" group="Telescope/Pointing" perm="rw" state="Idle">
        <defNumber name="RA" label="JNow RA" step="1" max="24" min="0" format="%.6f">0.0</defNumber>
        <defNumber name="DEC" label="JNow Dec" step="1" max="90" min="-90" format="%.6f">0.0</defNumber>
    </defNumberVector>
    <defNumberVector device="Seestar" name="TARGET_EOD_COORD" label="Target Coordinates" group="Telescope/Pointing" perm="ro" state="Idle">
        <defNumber name="RA" label="JNow RA" step="1" max="24" min="0" format="%.6f">0.0</defNumber>
        <defNumber name="DEC" label="JNow Dec" step="1" max="90" min="-90" format="%.6f">0.0</defNumber>
    </defNumberVector>
    <defNumberVector device="Seestar" name="HORIZONTAL_COORD" label="Topocentric Coordinates" group="Telescope/Pointing" perm="rw" state="Idle">
        <defNumber name="ALT" label="Altitude" step="1" max="90" min="-90" format="%.6f">0.0</defNumber>
        <defNumber name="AZ" label="Azimuth" step="1" max="360" min="0" format="%.6f">0.0</defNumber>
    </defNumberVector>
    <defSwitchVector device="Seestar" name="ON_COORD_SET" label="Coord set action" group="Telescope/Pointing" rule="OneOfMany" perm="rw" state="Idle">
        <defSwitch name="SLEW" label="Slew">On</defSwitch>
        <defSwitch name="TRACK" label="Track">Off</defSwitch>
        <defSwitch name="SYNC" label="Sync">Off</defSwitch>
    </defSwitchVector>
    <defSwitchVector device="Seestar" name="TELESCOPE_MOTION_NS" label="Move North/South" group="Telescope/Pointing" rule="AtMostOne" perm="wo" state="Idle">
        <defSwitch name="MOTION_NORTH" label="Move North">Off</defSwitch>
        <defSwitch name="MOTION_SOUTH" label="Move South">Off</defSwitch>
    </defSwitchVector>
    <defSwitchVector device="Seestar" name="TELESCOPE_MOTION_WE" label="Move East/West" group="Telescope/Pointing" rule="AtMostOne" perm="wo" state="Idle">
        <defSwitch name="MOTION_WEST" label="Move West">Off</defSwitch>
        <defSwitch name="MOTION_EAST" label="Move East">Off</defSwitch>
    </defSwitchVector>
    <defNumberVector device="Seestar" name="TELESCOPE_INFO" label="Optical Properties" group="Telescope/Pointing" perm="ro" state="Idle">
        <defNumber name="TELESCOPE_APERTURE" label="Aperture (mm)" step="1" max="None" min="0" format="%.1f">50.0</defNumber>
        <defNumber name="TELESCOPE_FOCAL_LENGTH" label="Focal Length (mm)" step="1" max="None" min="0" format="%.1f">250.0</defNumber>
    </defNumberVector>
    <defNumberVector device="Seestar" name="DEW_HEATER" label="Dew Heater Power" group="Telescope/Pointing" perm="rw" state="Idle">
        <defNumber name="DEW_HEATER_POWER" label="Power Setting (%)" step="1" max="100" min="0" format="%f">0</defNumber>
    </defNumberVector>
    <defSwitchVector device="Seestar" name="TELESCOPE_PARK" label="Raise/Lower Arm" rule="OneOfMany" group="Telescope/Pointing" perm="rw" state="Idle">
        <defSwitch name="PARK" label="Close/Lower Arm">On</defSwitch>
        <defSwitch name="UNPARK" label="Raise Arm">Off</defSwitch>
    </defSwitchVector>
    <defNumberVector device="Seestar" name="TELESCOPE_PARK_POSITION" label="Park Position" group="Telescope/Pointing" perm="ro" state="Idle">
        <defNumber name="PARK_ALT" label="Altitude" step="1" max="90" min="-90" format="%.1f">-90</defNumber>
        <defNumber name="PARK_AZ" label="Azimuth" step="1" max="360" min="0" format="%.1f">0</defNumber>
    </defNumberVector>
    <defSwitchVector device="Seestar" name="TELESCOPE_PARK_OPTION" label="Park Setting" group="Telescope/Pointing" rule="OneOfMany" perm="ro" state="Idle">
        <defSwitch name="PARK_DEFAULT" label="Default">On</defSwitch>
        <defSwitch name="PARK_CURRENT" label="Current">Off</defSwitch>
        <defSwitch name="PARK_WRITE_DATA" label="Write Data">Off</defSwitch>
    </defSwitchVector>
    <defSwitchVector device="Seestar" name="TELESCOPE_PIER_SIDE" label="Mount Pier Side" group="Telescope/Pointing" rule="AtMostOne" perm="ro" state="Idle">
        <defSwitch name="PIER_EAST" label="East">Off</defSwitch>
        <defSwitch name="PIER_WEST" label="West">Off</defSwitch>
    </defSwitchVector>
    <defSwitchVector device="Seestar" name="TELESCOPE_HOME" label="Telescope homing" group="Telescope/Pointing" rule="AtMostOne" perm="wo" state="Idle">
        <defSwitch name="FIND" label="Find home position">Off</defSwitch>
        <defSwitch name="SET" label="Set current position as home">Off</defSwitch>
        <defSwitch name="GO" label="Go to home position">Off</defSwitch>
    </defSwitchVector>

    <!-- camera -->
    <!-- 'CCD_EXPOSURE' and 'CCD_ABORT_EXPOSURE' are handled in source -->
    <defNumberVector device="Seestar" name="CCD_FRAME" label="Frame Info" group="Camera" perm="ro" state="Idle">
        <defNumber name="X" step="1" max="None" min="0" format="%.0f" label="Left-Most Pixel Index">0</defNumber>
        <defNumber name="Y" step="1" max="None" min="0" format="%.0f" label="Top-Most Pixel Index">0</defNumber>
        <defNumber name="WIDTH" step="1" max="None" min="0" format="%.0f" label="Frame Width">1080</defNumber>
        <defNumber name="HEIGHT" step="1" max="None" min="0" format="%.0f" label="Frame Height">1920</defNumber>
    </defNumberVector>
    <!-- Number vector 'CCD_TEMPERATURE' defined in source -->
    <defSwitchVector device="Seestar" name="CCD_COOLER" label="Cooler Status" group="Camera" rule="OneOfMany" perm="ro" state="Idle">
        <defSwitch name="COOLER_ON" label="On">Off</defSwitch>
        <defSwitch name="COOLER_OFF" label="Off">On</defSwitch>
    </defSwitchVector>
    <defNumberVector device="Seestar" name="CCD_COOLER_POWER" label="Cooler Power" group="Camera" perm="ro" state="Idle">
        <defNumber name="CCD_COOLER_VALUE" step="1" max="None" min="0" format="%.0f" label="Power (%)">0</defNumber>
    </defNumberVector>
    <defSwitchVector device="Seestar" name="CCD_FRAME_TYPE" label="Exposure Type" group="Camera" rule="OneOfMany" perm="rw" state="Idle">
        <defSwitch name="FRAME_LIGHT" label="Light">On</defSwitch>
        <defSwitch name="FRAME_BIAS" label="Bias">Off</defSwitch>
        <defSwitch name="FRAME_DARK" label="Dark">Off</defSwitch>
        <defSwitch name="FRAME_FLAT" label="Flat">Off</defSwitch>
    </defSwitchVector>
    <defNumberVector device="Seestar" name="CCD_BINNING" label="Camera Binning" group="Camera" perm="rw" state="Idle">
        <defNumber name="HOR_BIN" step="1" max="2" min="1" format="%.0f" label="Horizontal Binning">1</defNumber>
        <defNumber name="VER_BIN" step="1" max="2" min="1" format="%.0f" label="Vertical Binning">1</defNumber>
    </defNumberVector>
    <defNumberVector device="Seestar" name="CCD_INFO" label="Sensor Info" group="Camera" perm="ro" state="Idle">
        <defNumber name="CCD_MAX_X" step="1" max="None" min="0" format="%.0f" label="Horizontal Resolution">1080</defNumber>
        <defNumber name="CCD_MAX_Y" step="1" max="None" min="0" format="%.0f" label="Vertical Resolution">1920</defNumber>
        <defNumber name="CCD_PIXEL_SIZE" step="1" max="None" min="0" format="%.1f" label="Pixel Size (μm)">2.9</defNumber>
        <defNumber name="CCD_PIXEL_SIZE_X" step="1" max="None" min="0" format="%.1f" label="Horizontal Pixel Size (μm)">2.9</defNumber>
        <defNumber name="CCD_PIXEL_SIZE_Y" step="1" max="None" min="0" format="%.1f" label="Vertical Pixel Size (μm)">2.9</defNumber>
        <defNumber name="CCD_BITSPERPIXEL" step="4" max="32" min="1" format="%.0f" label="Bits Per Pixel">16</defNumber>
    </defNumberVector>
    <defTextVector device="Seestar" name="CCD_CFA" label="Bayer Matrix" group="Camera" perm="ro" state="Idle">
        <defText name="CFA_OFFSET_X" label="Bayer X offset">0</defText>
        <defText name="CFA_OFFSET_Y" label="Bayer Y offset">0</defText>
        <defText name="CFA_TYPE" label="Bayer pattern">GRBG</defText>
    </defTextVector>
    <defNumberVector device="Seestar" name="CCD_TEMPERATURE" label="Camera Temperature" group="Camera" perm="ro" state="Idle">
        <defNumber name="CCD_TEMPERATURE_VALUE" step="0.1" max="100.0" min="-273.15" format="%.2f" label="Temperature (C)">0.0</defNumber>
    </defNumberVector>
    <!-- BLOB vector 'CCD1' defined in source -->

    <!-- focuser -->
    <defNumberVector device="Seestar" name="FOCUS_SPEED" label="Focuser Speed" group="Focus" perm="ro" state="Idle">
        <defNumber name="FOCUS_SPEED_VALUE" label="Speed" step="1" max="1" min="0" format="%.0f">1</defNumber>
    </defNumberVector>
    <defNumberVector device="Seestar" name="ABS_FOCUS_POSITION" label="Absolute Position" group="Focus" perm="rw" state="Idle">
        <defNumber name="FOCUS_ABSOLUTE_POSITION" label="Focuser Position" step="5" max="2600" min="1000" format="%.0f">-1</defNumber>
    </defNumberVector>
    <defSwitchVector device="Seestar" name="FOCUS_MOTION" label="Travel Direction" group="Focus" rule="OneOfMany" perm="rw" state="Idle">
        <defSwitch name="FOCUS_INWARD" label="Inward">Off</defSwitch>
        <defSwitch name="FOCUS_OUTWARD" label="Outward">On</defSwitch>
    </defSwitchVector>
    <defNumberVector device="Seestar" name="REL_FOCUS_POSITION" label="Relative Position" group="Focus" perm="wo" state="Idle">
        <defNumber name="FOCUS_RELATIVE_POSITION" label="Steps" step="5" max="50" min="0" format="%.0f">0</defNumber>
    </defNumberVector>
    <defNumberVector device="Seestar" name="FOCUS_MAX" label="Focuser Maximum" group="Focus" perm="ro" state="Idle">
        <defNumber name="FOCUS_MAX_VALUE" label="Max. Position" step="1" max="2600" min="2600" format="%.0f">2600</defNumber>
    </defNumberVector>
    <defSwitchVector device="Seestar" name="FOCUS_REVERSE_MOTION" label="Reverse Motion" group="Focus" rule="OneOfMany" perm="rw" state="Idle">
        <defSwitch name="ENABLED" label="Enabled">Off</defSwitch>
        <defSwitch name="DISABLED" label="Disabled">On</defSwitch>
    </defSwitchVector>
    <defSwitchVector device="Seestar" name="FOCUS_ABORT_MOTION" label="Cancel Motion" group="Focus" rule="OneOfMany" perm="wo" state="Idle">
        <defSwitch name="ABORT" label="Abort">Off</defSwitch>
    </defSwitchVector>
    <defSwitchVector device="Seestar" name="AUTOFOCUS" label="Autofocus" group="Focus" rule="AtMostOne" perm="wo" state="Idle">
        <defSwitch name="START_AUTOFOCUS" label="Start Autofocus Routine">Off</defSwitch>
        <defSwitch name="STOP_AUTOFOCUS" label="Stop Autofocus Routine">Off</defSwitch>
    </defSwitchVector>

    <!-- filter wheel -->
    <defNumberVector device="Seestar" name="FILTER_SLOT" label="Active Slot" group="Filters" perm="rw" state="Idle">
        <defNumber name="FILTER_SLOT_VALUE" label="Current Filter Position" step="1" max="2" min="0" format="%.0f">-1</defNumber>
    </defNumberVector>
    <defTextVector device="Seestar" name="FILTER_NAME" label="Active Filter" group="Filters" perm="ro" state="Idle">
        <defText name="FILTER_NAME_VALUE" label="Current Filter Name">unset</defText>
    </defTextVector>

</INDIDriver>
